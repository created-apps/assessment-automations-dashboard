{
  "name": "assessment-automations",
  "version": "1.0.0",
  "private": true,
  "description": "Slack-driven follow-up for newly created WhatsApp groups: assessments, mentor intros and booking links",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "nudge": "tsx src/nudge-once.ts",
    "mentors": "tsx src/mentors-cli.ts",
    "check-assessments": "tsx src/check-assessments-once.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
