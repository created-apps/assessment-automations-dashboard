# --- Periskope --------------------------------------------------------------
# The same workspace as the group-creation service: this service only sends
# messages into groups that service has already made.
PERISKOPE_API_KEY=
PERISKOPE_PHONE=
PERISKOPE_BASE_URL=https://api.periskope.app/v1

# --- Supabase ---------------------------------------------------------------
# The group-creation service's project -- the same values it uses. This
# service's two tables (group_cases, case_actions) live in that database and
# are reached over the REST API with the service key; there is no ORM and no
# migration tool on this side. Create the tables once by running
# sql/001_init.sql in the Supabase SQL editor.
#
# Service-role key: it bypasses row-level security, which is what lets this
# service read the tables at all. Keep it secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# --- Slack ------------------------------------------------------------------
# Bot user token, xoxb-... Scope: chat:write. Nothing else -- Slack is a
# notification channel now, so channels:history is no longer needed and the
# app needs no Event Subscriptions.
SLACK_BOT_TOKEN=
# Channel the "what should we do for this group?" messages are posted into.
# The channel id (C0123ABCD), not the name. Invite the bot to it.
SLACK_CHANNEL_ID=

# --- Operations dashboard ---------------------------------------------------
# Bearer token the dashboard's server sends on /api/*. Set the same value as
# BACKEND_API_SECRET in the frontend. Only the dashboard's server calls this --
# it never reaches a browser.
DASHBOARD_API_SECRET=
# Public URL of the dashboard. Slack nudges deep-link to the group here, since
# a nudge is now a notification rather than something to reply to.
DASHBOARD_URL=https://ops.example.com

# --- Intake webhook ---------------------------------------------------------
# Shared with the group-creation service, which sends it as a bearer token on
# POST /group-created. Set the same value there as ASSESSMENT_WEBHOOK_SECRET.
INTAKE_SHARED_SECRET=

# --- Assessment forms -------------------------------------------------------
# Defaults are the live forms; override only if they are replaced.
CS_ASSESSMENT_URL=https://docs.google.com/forms/d/e/1FAIpQLSex5LuvsmlAf6GG6f7RoFsOGMQ_4vgjyXEji1rMM_eG_MQ9Lw/viewform?usp=sf_link
PROTOTYPING_ASSESSMENT_URL=https://docs.google.com/forms/d/e/1FAIpQLSdrh1pzdFH8XG5QMZcXpo3EX6a5wl4wN9rgb_oj__XsU8AMPg/viewform?usp=sf_link

# --- Assessment completion check --------------------------------------------
# The Google Form RESPONSE spreadsheets for the two assessments. When a
# student's email appears in one, they've completed it -- the hourly cron posts
# to Slack. Share both sheets with the service account (GOOGLE_CREDENTIALS_BASE64).
# The sheet id is the long token in the sheet URL (/spreadsheets/d/<ID>/edit).
# Leave a sheet id blank to not check that assessment.
CS_RESPONSES_SHEET_ID=
CS_RESPONSES_TAB=Form Responses 1
PROTOTYPING_RESPONSES_SHEET_ID=
PROTOTYPING_RESPONSES_TAB=Form Responses 1
# The column header holding the respondent's email in those sheets.
ASSESSMENT_RESPONSES_EMAIL_COLUMN=Email Address
# Stop checking a case this many days after its assessment was sent.
ASSESSMENT_CHECK_WINDOW_DAYS=30
# Hourly by default.
ASSESSMENT_COMPLETION_CRON=0 * * * *

# --- SYNC (separate Supabase) -----------------------------------------------
# SYNC's own Supabase project. At mentor-introduction time this service looks up
# the mentor's phone/email here and links them into user_group_memberships.
# Optional -- leave blank and those follow-ups are skipped (with a warning).
SYNC_SUPABASE_URL=https://<sync-ref>.supabase.co
SYNC_SUPABASE_SERVICE_KEY=
# How a mentor's number is written into SYNC's users.phone_number when their
# account is created. Lookups always try both shapes; this only sets the format
# of rows we insert. Must match the group-creation service, which writes
# students and parents into the same table. "digits" (default) or "plus".
USER_PHONE_FORMAT=digits

# --- Google Sheet write-back ------------------------------------------------
# The intake spreadsheet the Automations service reads from. This service writes
# back the mentor details (on introduction) and the project title/description
# (from the dashboard's Project Setup action) to the student's row.
# Use the SAME service account as the Automations service; share the sheet with
# it. base64 of the service-account JSON key. Optional -- blank skips the writes.
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
# Reading the project title/description back out of the intake sheet. One
# Sheets request per tick covers every case.
SHEET_SYNC_CRON=*/5 * * * *
# Retrying the SYNC accounts of mentors added while SYNC was unreachable.
MENTOR_SYNC_CRON=*/15 * * * *
# Draining the per-case action queues. Every minute: the runner sends at most
# one action per case per tick, so the pacing dial is QUEUE_GAP_SECONDS.
QUEUE_CRON=* * * * *
# How long to leave between two queued messages to the same group, so a family
# that has just joined isn't hit with everything at once.
QUEUE_GAP_SECONDS=60

# --- Curriculum subjects (Project Setup action) -----------------------------
# The subject labels the dashboard's Stage 5 "Project Setup" action offers.
# Comma separated. These must match the keys in the project-setup service's
# CURRICULUM_TEMPLATES_JSON, since that service maps the chosen label to a Drive
# template folder. Leave blank if Stage 5 curriculum copying isn't set up yet.
CURRICULUM_SUBJECTS=AI,Biology,AI+Bio,Psychology_Research

# --- Booking links ----------------------------------------------------------
# "Schedule a meeting with <name>" sends the matching link into the group.
# At least one must be set. Names are matched fuzzily, so "urja javeri" finds
# Urja Jhaveri; the spelling above is what the family sees.
CALENDLY_AASHNA_SARAF=https://calendly.com/<aashna>
CALENDLY_URJA_JHAVERI=https://calendly.com/<urja>
CALENDLY_DHRUV_SINGH=https://calendly.com/<dhruv>

# --- Mentor nudge -----------------------------------------------------------
PORT=3000
# Daily at 09:30. Once an assessment or booking link has gone out, this asks in
# the group's Slack thread whether the mentor has been finalized.
NUDGE_CRON=30 9 * * *
# Floor between two nudges for the same group, whatever the cron does -- keeps
# a redeploy from producing a second reminder the same day.
NUDGE_MIN_INTERVAL_HOURS=20
# 0 = never stop asking. A group is chased until a mentor is actually
# introduced; only that takes it out of the rotation. Set a positive number of
# days to restore a cutoff, after which the case is marked ABANDONED.
NUDGE_GIVE_UP_AFTER_DAYS=0

# --- Mentor name matching ---------------------------------------------------
# Below this score a name is reported back to Slack as unmatched rather than
# guessed at. Raise it if a wrong mentor is ever matched; lower it if correct
# names are being rejected. Check with: npm run mentors -- "<name>"
MENTOR_MIN_MATCH_SCORE=0.72
# Two candidates within this of each other are treated as ambiguous and sent
# back to the thread instead of being picked between.
MENTOR_AMBIGUITY_MARGIN=0.05
