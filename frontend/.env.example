# --- Automations backend -----------------------------------------------------
# The assessment-automations service. Every group, action and message goes
# through it — this dashboard holds no Supabase or Periskope credentials of its
# own.
#
# Server-side only. Deliberately NOT prefixed NEXT_PUBLIC_: the browser must
# never see either of these, which is why the browser calls this app's own
# routes under /api and they call the backend.
BACKEND_API_URL=http://localhost:3000
# Must equal DASHBOARD_API_SECRET in the backend's .env.
BACKEND_API_SECRET=

# --- Sessions -----------------------------------------------------------------
# Signing key for the session cookie. Any long random string:
#   openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=

# --- Dashboard users ----------------------------------------------------------
# Postgres holding public.dashboard_users. Point at the same project as the
# backend's tables (hqyobval…), NOT the one holding student records.
#
# There are no built-in accounts: with this unset, nobody can sign in. Create
# users with `pnpm invite:user` after running scripts/001-create-users.sql.
DATABASE_URL=
